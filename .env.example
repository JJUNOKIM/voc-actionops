# Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=voc_actionops
MYSQL_USER=local_user
MYSQL_PASSWORD=local_password
MYSQL_ROOT_PASSWORD=root_password

# Authentication
JWT_SECRET=replace-with-at-least-32-byte-secret
JWT_ACCESS_TOKEN_EXPIRATION=30m
JWT_REFRESH_TOKEN_EXPIRATION=14d

# Local demo
DEMO_DATA_ENABLED=true
DEMO_ORGANIZATION_NAME=VOC ActionOps Demo
DEMO_USER_EMAIL=admin@voc-actionops.local
DEMO_USER_PASSWORD=demo-password
DEMO_USER_NAME=Demo Admin

# Frontend
FRONTEND_PORT=3000

# AI
AI_PROVIDER=deterministic
AI_WORKER_API_KEY=replace-with-at-least-16-character-key
AI_WORKER_PORT=8000
AI_WORKER_MODEL_NAME=deterministic-v1
AI_WORKER_CONNECT_TIMEOUT=2s
AI_WORKER_READ_TIMEOUT=30s
AI_WORKER_MAX_ATTEMPTS=3
OPENAI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=your-api-key
OPENAI_TIMEOUT_SECONDS=30
AI_WORKER_BASE_URL=http://localhost:8000
